{
  "expo": {
    "name": "AI Spelling Tutor",
    "slug": "spelling-tutor-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mascot/icon.png",
    "userInterfaceStyle": "light",
    "sdkVersion": "54.0.0",
    "splash": {
      "backgroundColor": "#FFFBF0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourname.spellingtutor"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFB830"
      },
      "package": "com.yourname.spellingtutor",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "spellingtutor",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bb76c807-00da-4957-873e-6fe09540f10f"
      }
    }
  }
}
